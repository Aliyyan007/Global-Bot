# ===== REQUIRED =====
# Bot token from https://discord.com/developers/applications
discordToken=
# Primary MongoDB connection string (mongodb+srv://...)
mongoDB_SRV=

# ===== OPTIONAL =====
# Secondary/read-replica MongoDB (falls back to primary if unset)
mongoDB_SRV_SECONDARY=
# Dedicated MongoDB for auto-voice preferences (falls back to primary if unset)
mongoDB_SRV_AUTOVOICE=
# Backup MongoDB cluster used by backup features
mongoDB_SRV_BACKUP=

# Redis instances for caching (all optional — bot degrades to MongoDB-only mode)
REDIS_URL_1=
REDIS_URL_2=
REDIS_URL_3=

# Discord user ID of the bot owner
OWNER_ID=

# Backblaze B2 storage (emoji/sticker backup features)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=

# Third-party APIs
UNSPLASH_ACCESS_KEY=
GROQ_API_KEY=
# Force a specific Groq model for the AI embed generator (optional — the bot
# already auto-falls-back across several models if one is deprecated)
# GROQ_MODEL=

# Deployment: path for auto-voice data file. On Render point this at a
# mounted persistent disk, e.g. /var/data/voice_data.json
# VOICE_DATA_PATH=
